# ---------------------------------------------------------------------------
# Pawster — provisioning values (root `.env`)
#
# This file is NOT read at runtime. `web/` and `digest/` get their configuration
# from their own `wrangler.jsonc` (`vars`) and from `.dev.vars` locally /
# `wrangler secret put` in production. This file is the record of what
# `scripts/provision.sh` captured, and what `wrangler`/`gh` need on your machine.
#
# Copy to `.env` and fill in. `./scripts/provision.sh` writes these for you and
# offers anything already present as the default, so it is safe to re-run.
# ---------------------------------------------------------------------------

# --- Cloudflare -------------------------------------------------------------
# Account ID: dash.cloudflare.com → right-hand sidebar (32 hex chars).
CLOUDFLARE_ACCOUNT_ID=
# API token with D1 / R2 / Queues / Workers edit scopes. Also set as a GitHub
# Actions secret by provision.sh.
CLOUDFLARE_API_TOKEN=
# Empty by design under ADR 0014: the domain lives outside Cloudflare, so there
# is no zone. Only set if you ever add one (you should not — see the README).
CLOUDFLARE_ZONE_ID=

# --- D1 ---------------------------------------------------------------------
# Must match `database_name` in both wrangler.jsonc files.
D1_DATABASE_NAME=pawster
# From `wrangler d1 create pawster`. Paste it into `database_id` in BOTH
# web/wrangler.jsonc and digest/wrangler.jsonc (they are committed placeholders).
D1_DATABASE_ID=

# --- R2 ---------------------------------------------------------------------
# Public bucket for derivatives.
R2_BUCKET=pawster
# Private bucket for originals, 7-day expiry lifecycle (ADR 0012). Never public:
# a retained original still carries the EXIF the derivatives strip.
R2_ORIGINALS_BUCKET=pawster-originals
R2_ORIGINALS_LIFECYCLE=
# Auto-generated `pub-<hash>.r2.dev` hostname. There is no R2 custom domain, now
# or later (ADR 0011, superseded by ADR 0014).
R2_PUBLIC_HOST=
R2_ACTIVATION_ASKED_FOR_CARD=
R2_BUDGET_ALERT=

# --- Queues -----------------------------------------------------------------
QUEUE_NAME=pawster-digest
# The dead-letter queue must exist as a real queue before digest/ can name it
# (ADR 0009): its consumer is what pings the Healthchecks /fail endpoint.
QUEUE_DLQ_NAME=pawster-digest-dlq

# --- Resend (email) ---------------------------------------------------------
# API key from resend.com/api-keys. The same key both Workers hold under this
# name — set it as a Worker secret, do not rely on this file at runtime.
RESEND_API_KEY=
# The verified sending subdomain, e.g. `mail.pawster.dpdns.org`.
RESEND_SENDING_DOMAIN=
RESEND_DOMAIN_STATUS=

# --- Domain (ADR 0014) ------------------------------------------------------
# The free subdomain, e.g. `pawster.dpdns.org`. Acquired by
# `./scripts/provision-domain.sh`. Empty if you ran `provision.sh --no-domain`.
PAWSTER_DOMAIN=
PAWSTER_ADMIN_EMAIL=

# --- Watchdog (ADR 0006) ----------------------------------------------------
# Healthchecks.io check URL. Lives outside Cloudflare on purpose: nothing inside
# Cloudflare can report a cron run that never fired.
HEALTHCHECKS_PING_URL=
# Mirror of the cron in digest/wrangler.jsonc, recorded for the record only.
DIGEST_CRON_UTC=0 11 * * *

# --- Long-lived secrets -----------------------------------------------------
# The Do-Not-Contact pepper (ADR 0010). MUST NEVER ROTATE — rotating it orphans
# every existing DNC hash. provision.sh generates it once and never regenerates
# it while it is present here. Back it up somewhere outside this machine.
PAWSTER_DNC_PEPPER=
PAWSTER_DNC_PEPPER_BACKUP=
# A fixed hash of a known input under the pepper, so a wrong pepper is caught.
PAWSTER_DNC_CANARY=
# Signs unsubscribe links (`UNSUBSCRIBE_SECRET` in the digest Worker).
PAWSTER_LINK_SIGNING_KEY=
# Signs admin verification links (`ADMIN_LINK_SECRET` in the web Worker).
# scripts/admin-link.mjs reads it from here to mint a pending-list link or to
# revoke a shelter — the two acts no link in an inbox can perform.
PAWSTER_ADMIN_LINK_SECRET=

# --- Observations (record only, not configuration) --------------------------
IMAGES_TRANSFORMATIONS_ON_FREE=
