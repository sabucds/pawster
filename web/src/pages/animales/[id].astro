---
import { animals, createDb, shelters } from "@pawster/db";
import { deriveAgeBand, isListed } from "@pawster/domain";
import { env } from "cloudflare:workers";
import { eq } from "drizzle-orm";
import { ageBandLabel } from "../../lib/animals/words.ts";
import { readShelterFacts } from "../../lib/auth/store.ts";

/**
 * One of the few server-rendered routes: the animal detail page reads one row from D1,
 * which ADR 0007 puts comfortably inside the 10 ms ceiling. This is the exception that
 * `export const prerender = false` exists to mark — prerendering the detail page for every
 * animal would be a rebuild on every publish.
 *
 * ## The listing gate, and why it 404s
 *
 * `CONTEXT.md` defines a Listing as the *public, visible state* of an animal, and `isListed()`
 * is its four clauses: available, shelter verified, at least one contact point, shelter not
 * departed. This page asks that question and answers **404** when it is false, which is issue
 * #55's last acceptance criterion — "nothing published by an unverified shelter is publicly
 * reachable".
 *
 * A 404 rather than a 403 or a "not available yet" page, and that is the honest status: an
 * unlisted animal has no public existence to describe. A page saying "this animal is hidden"
 * would leak both that the id is real and that the shelter is unverified, to anyone who guessed.
 *
 * **Right now this is every animal on the platform.** `readShelterFacts()` returns
 * `latestVerificationOutcome: null` for every shelter — ADR 0003 makes pending the *absence* of
 * a log entry and issue #53 adds the log — so no animal is publicly reachable yet. That is the
 * model working rather than a gap: the shelter's own page (`refugios/animales/[id].astro`) is
 * where a shelter sees its animal and is told why the public cannot.
 */
export const prerender = false;

const { id } = Astro.params;

/**
 * Built here, in the frontmatter, which Astro runs once per request for a route that has
 * opted out of prerendering — so this is per-request construction, not module scope, even
 * though it reads like a top-level `const` (see `db/src/index.ts`).
 *
 * `env` comes from `cloudflare:workers`: `Astro.locals.runtime.env` was removed in
 * Astro v6 and throws if you reach for it.
 */
const db = createDb(env.DB);

const [row] = await db
  .select({
    id: animals.id,
    shelterId: animals.shelterId,
    name: animals.name,
    species: animals.species,
    /** Read for one reason: the age band's Spanish word has to agree with it. */
    sex: animals.sex,
    region: animals.region,
    availability: animals.availability,
    estimatedBirthDate: animals.estimatedBirthDate,
    lastConfirmedAt: animals.lastConfirmedAt,
    shelterName: shelters.displayName,
  })
  .from(animals)
  .innerJoin(shelters, eq(animals.shelterId, shelters.id))
  .where(eq(animals.id, id!))
  .limit(1);

if (!row) {
  return new Response("No encontrado", { status: 404 });
}

/**
 * The shelter's side of the listing rule, read through the one function that assembles it.
 *
 * Not a wider join, because `scripts/check-source-rules.mjs` fences the account-email column to
 * the store modules and a page writing its own shelter select is how that fence gets stepped
 * over. `readShelterFacts()` returns the three clauses and nothing else.
 */
const facts = await readShelterFacts(db, row.shelterId);

if (!facts || !isListed({ availability: row.availability }, facts)) {
  return new Response("No encontrado", { status: 404 });
}

// Derived at read time, never stored, so the animal graduates on its own (ADR 0004).
const ageBand = deriveAgeBand(row.species, row.estimatedBirthDate, new Date());
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{row.name} — Pawster</title>
  </head>
  <body>
    <h1 data-testid="animal-name">{row.name}</h1>

    <!--
      **Deliberately still the four fields this page rendered before issue #55.** The ticket owes
      this page its listing *gate*, not its contents: the description, the photographs, the
      contact hand-off and the archive view are issue #57's. Building them here would be building
      them unreachable — every animal 404s until #53 lands verification, so none of it could be
      seen, let alone tested in the positive path. The animal's own shelter reads the full record
      at `refugios/animales/[id].astro`, which is the surface #55 does need.
    -->
    <dl>
      <dt>Refugio</dt>
      <dd data-testid="shelter-name">{row.shelterName}</dd>
      <dt>Región</dt>
      <dd data-testid="region">{row.region}</dd>
      <dt>Etapa</dt>
      <!--
        Through `ageBandLabel()` rather than the raw band: `deriveAgeBand()` returns `"Young"`,
        and `Etapa: Young` on an es-VE page is English leaking onto a Spanish surface.
        CONTEXT.md's vocabulary table gives the band its words, and they inflect —
        `Adulto / Adulta`, `Cachorro / Cachorra`.
      -->
      <dd data-testid="age-band">{ageBandLabel(ageBand, row.sex)}</dd>
    </dl>
  </body>
</html>
