# ---------------------------------------------------------------------------
# web/ — local Worker secrets and overrides.
#
# Read by `astro dev` through the adapter's `platformProxy`, which loads this
# file the way `wrangler dev` does. In production these secrets are set
# with `wrangler secret put`, never as a committed `var` — a plaintext var for
# either of the first two would put a shelter's whole credential in the repo.
#
# Copy to `web/.dev.vars` and fill in. The `.dev.vars` file is gitignored.
# ---------------------------------------------------------------------------

# Signs the Session cookie. Any random string locally; the only thing standing
# between a hand-written cookie and a shelter's publishing area in production.
#   openssl rand -base64 32
SESSION_SECRET=

# Keys the One-Time Code hash and the sign-in ledger's IP fingerprints.
# Separate from SESSION_SECRET so rotating codes does not sign everyone out.
#   openssl rand -base64 32
SIGN_IN_SECRET=

# Signs the capability handed to Cloudflare's image pipeline over one original
# object at upload (ADR 0012). Its own secret because it is the only key here
# presented by something outside the platform: it travels in a URL to Cloudflare
# and lands in whatever that pipeline logs. Rotating it costs five minutes of
# in-flight uploads; rotating SESSION_SECRET signs every shelter out.
#   openssl rand -base64 32
ORIGINAL_SECRET=

# Signs every admin capability: the decision link a registration mails, the
# pending-list link, and the revocation token `scripts/admin-link.mjs` mints.
# Its own secret because rotating it invalidates the admin's links and nothing
# else — where rotating SIGN_IN_SECRET invalidates every outstanding code.
#   openssl rand -base64 32
ADMIN_LINK_SECRET=

# Shared with digest/, same key under the same name. From resend.com/api-keys.
# Leave blank to develop everything except actually sending sign-in mail — the
# code is logged by Resend's failure path, not delivered.
RESEND_API_KEY=

# Overrides of the `vars` in web/wrangler.jsonc, for local dev only.
# SITE_ORIGIN is the origin the sign-in email tells a shelter to type, so it has
# to be the dev server's, not production's.
SIGN_IN_FROM_ADDRESS=entrar@pawster.test
SITE_ORIGIN=http://localhost:4321
# Who decisions are attributed to and where decision mail goes. Locally, any
# address you can read.
ADMIN_EMAIL=admin@pawster.test
VERIFICATION_FROM_ADDRESS=verificacion@pawster.test
