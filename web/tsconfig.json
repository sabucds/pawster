{
  "extends": ["astro/tsconfigs/strict", "../tsconfig.base.json"],
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    ".astro/types.d.ts",
    "worker-configuration.d.ts",
    "src/**/*",
    "test/**/*.ts",
    "../test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "bundled", "node_modules"]
}
